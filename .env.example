# Copie este arquivo para ".env" e preencha com a configuração do app da Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK).
# Sem estas chaves, o app abre em modo demonstração.
# Estas chaves identificam o projeto; a proteção dos dados está nas regras (firestore.rules).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fotos no Cloud Storage (exige plano Blaze). Deixe vazio para guardar no Firestore.
VITE_USAR_STORAGE=
