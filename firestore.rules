rules_version = '2';

// Quem pode ler e escrever o quê no banco de dados do Missão Viaturas.
// Funções (chave gravada → nome no app): coordenador → Comandante da Missão (oficial), supervisor → Gestor (3º ano),
// responsavel → Supervisor (1º ano /1), auxiliar → Responsável (1º ano /2).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function eu() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function meuPerfil() {
      return eu().perfil;
    }
    function minhaFuncao() {
      return eu().get('funcao', '');
    }
    function membro() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && !(meuPerfil() in ['pendente', 'removido']);
    }
    // Coordenador e administrador: liberam a equipe e definem as funções
    function gestor() {
      return membro() && meuPerfil() in ['coordenador', 'admin'];
    }
    // Escala: montada pelos responsáveis (e pelo coordenador e administrador)
    function montaEscala() {
      return gestor() || (membro() && minhaFuncao() == 'responsavel');
    }
    // Excluir relatório enviado: responsáveis, supervisores, coordenador e administrador
    function excluiRelatorio() {
      // (quem tinha o perfil antigo "supervisao" conta como supervisor)
      return gestor() || (membro() && (minhaFuncao() in ['responsavel', 'supervisor'] || meuPerfil() == 'supervisao'));
    }
    function funcaoValida(f) {
      return f in ['coordenador', 'supervisor', 'responsavel', 'auxiliar'];
    }

    // Cadastro: cada um cria o próprio perfil como "pendente"; o coordenador libera e define a função
    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || membro();
      allow create: if logado() && request.auth.uid == uid
        && !('funcao' in request.resource.data)
        && (request.resource.data.perfil == 'pendente'
          // Primeiro administrador do app (dono do projeto) já entra liberado
          || (request.resource.data.perfil == 'admin'
            && request.auth.token.email == 'adriano.advag@gmail.com'));
      // O próprio usuário edita seus dados, mas não o perfil nem a função (o administrador pode mudar a própria função)
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.perfil == resource.data.perfil
        && (request.resource.data.get('funcao', '') == resource.data.get('funcao', '')
          || (resource.data.perfil == 'admin' && funcaoValida(request.resource.data.funcao)));
      // Coordenador libera, muda perfil e função dos outros e remove da missão (perfil 'removido');
      // só o admin cria outro admin ou mexe no acesso de um admin
      allow update: if gestor() && request.auth.uid != uid
        && (request.resource.data.perfil != 'admin' || meuPerfil() == 'admin')
        && (resource.data.perfil != 'admin' || meuPerfil() == 'admin')
        && (!('funcao' in request.resource.data) || funcaoValida(request.resource.data.funcao))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'funcao', 'removidoEm', 'removidoPor']);
      allow delete: if membro() && meuPerfil() == 'admin';
    }

    // Viaturas: todos os integrantes cadastram, editam, excluem e mudam a situação
    match /viaturas/{id} {
      allow read, create, update, delete: if membro();
    }

    // Vistoria do dia (um documento por rodada): editável até ser enviada; enviada, só pode ser excluída
    match /vistorias/{data} {
      allow read: if membro();
      allow create: if membro();
      allow update: if membro() && resource.data.get('status', 'rascunho') != 'enviada';
      allow delete: if excluiRelatorio();
    }

    // Pendências: abertas no envio da vistoria e resolvidas por qualquer integrante
    match /ocorrencias/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.status == 'aberta';
      allow update: if membro();
      // Ao excluir um relatório, saem junto as pendências que ele abriu
      allow delete: if excluiRelatorio();
    }

    // Escala semanal (um documento por semana, id = segunda-feira): todos veem, os responsáveis montam
    match /escalas/{semana} {
      allow read: if membro();
      allow create, update: if montaEscala();
    }

    // Fotos comprimidas (até ~900 KB cada)
    match /fotos/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.imagem.size() < 1000000;
      allow delete: if excluiRelatorio();
    }
  }
}
